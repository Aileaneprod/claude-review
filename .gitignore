# Secrets — never commit. The CLAUDE_CODE_OAUTH_TOKEN lives only in GitHub
# Actions secrets, never on disk in this repo.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Eval run artifacts (stub responses under eval/stubs/ ARE committed)
eval/.out/
eval/*.log

# Harvested review ledgers carry verbatim text from the repositories under
# review — author replies, finding bodies, file paths. This repo is public by
# constraint (docs/ARCHITECTURE.md, "The repo is public"), so they never
# belong here. They live in the private ledger repository; harvest with
# `scripts/harvest-feedback.sh --out <private-checkout>/feedback`.
feedback/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
