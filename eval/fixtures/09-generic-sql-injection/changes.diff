+def search_customers(term: str):
+    """Free-text customer search."""
+    sql = (
+        "SELECT id, email FROM customers "
+        f"WHERE email LIKE '%{term}%' OR name LIKE '%{term}%'"
+    )
+    with connection.cursor() as cur:
+        cur.execute(sql)
+        return cur.fetchall()
